def calcular_media(nota1,nota2,nota3):
    media = (nota1 + nota2 + nota3) / 3
    
    if media >=7:
        situacao = "aprovado"
    elif media == 5:
        situacao = "em recuperacao"
    else:
        situacao = "aluno reprovado"
    print(f"media = {media:.2f}, situação = {situacao}")
    return media

