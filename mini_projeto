print("----------------------------------------------------------")
print("---------- INSTITUTO FEDERAL ASAS PARA O FUTURO ----------")
print("-------------- SISTEMA DE CADASTRO DE ALUNOS -------------")
print("----------------------------------------------------------")

#SOLICITAÇÃO DOS DADOS DOS DISCENTES

discentes = []
quantidade = int(input("Quantos discentes deseja cadastrar? "))

for i in range(quantidade):
    print(f"\nCadastro do discente {i + 1}")
    nome = input("Digite o nome: ").strip()
    idade = int(input("Digite a idade: "))
    media = float(input("Digite a média: "))

    dados = {
        "nome": nome,
        "idade": idade,
        "media": media
    }
    discentes.append(dados)


#VERIFICAÇÃO DOS DISCENTES CADASTRADOS

print("\nDiscentes cadastrados:")
for discente in discentes:
    print(f"- {discente['nome']} | idade: {discente['idade']} | média: {discente['media']:.2f}")

#VERIFICAÇÃO DOS DISCENTES APROVADOS E REPROVADOS

print("\nSituação dos discentes:")
for discente in discentes:
   if discente["media"] >=7:
    print(f" - {discente['nome']} foi aprovado! ")
   else:
     print(f" - {discente['nome']} foi reprovado!")

#VERIFICAÇÃO DAS MÉDIAS DOS DISCENTES

print(f"\nA quantidade total de discentes é de {len(discentes)}")

soma_medias = sum(discente["media"] for discente in discentes)
media_turma = soma_medias / len(discentes)
print(f"A média da turma foi: {media_turma:.2f}")

maior_nota = max(discentes, key=lambda discente: discente["media"])
menor_nota = min(discentes, key=lambda discente: discente["media"])
print(f"A maior nota cadastrada foi do(a) discente {maior_nota['nome']} com média: {maior_nota['media']:.2f}")
print(f"A menor nota cadastrada foi do(a) discente {menor_nota['nome']} com média: {menor_nota['media']:.2f}")
